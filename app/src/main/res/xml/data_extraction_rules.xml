<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up the attendance log and settings (cloud + device transfer).
     Explicit JSON backup/restore arrives in Phase 6. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="arrivelog.db" />
        <include domain="file" path="datastore/settings.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="arrivelog.db" />
        <include domain="file" path="datastore/settings.json" />
    </device-transfer>
</data-extraction-rules>
